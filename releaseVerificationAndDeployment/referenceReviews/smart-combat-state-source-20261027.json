  "findings": [
    {
      "source": "state/beginState/getState/cancelState/endState",
      "intent": "Explicit priority, token and deadline give one actor a current semantic task, with preemption and termination.",
      "finding": "Duration<=0 creates no deadline. Cleanup is scoped to active state token but does not generally bind exact native movement/feature ownership. Several branches unconditionally reset TARGET/AUTOTARGET/posture/watch/forceSpeed or follow the current leader.",
      "disposition": "Retain single-owner finite-state/preemption intent through existing CBE operations/actor reservations; do not add the source parallel state machine or blanket restoration. Nonpositive durations and branch-specific semantics require caller review, not a claim every source task is unbounded."
    },
    {
      "source": "state/acquireMovementControl/releaseMovementControl",
      "intent": "Temporarily reduce native combat interference during deliberate movement and restore the previous feature/posture policy.",
      "finding": "Baseline captured once locally, then repeated acquire writes disableAI/posture/forceSpeed. Release restores saved features/posture without testing whether they are still owned and resets speed to-1 without capturing its prior value. Nonlocal release discards baseline metadata without native restoration.",
      "disposition": "Reject blanket resets and ownership-blind cleanup. Keep exact CBE lease/receipt/epoch/native-order checks. Locality transfer cannot be treated as successful restoration from this source layer alone."
    },
    {
      "source": "state/updateState",
      "intent": "Confirm a real carried grenade was consumed, retry at most2 requests, observe movement progress and stop stalled work.",
      "finding": "Expiry is checked after throw preparation/release processing. Native forceWeaponFire is a request; magazine-count decrease corroborates consumption but does not alone prove the requested projectile/target result. Generic movement uses horizontal arrival2.5m, progress0.75m and8s stall.",
      "disposition": "Keep intent through CBE original-expiry-before-queued/native-boundary checks and FiredMan/projectile evidence. Do not copy late timeout ordering, horizontal room-arrival proof or fixed stall constants into CQB. Caller-specific movement updater bodies remain unread."
    },
    {
      "source": "policy/isEligible/hasMissionOrders",
      "intent": "Respect mission/player/high-command control and allow limited combat initiative around ordinary MOVE orders.",
      "finding": "Eligibility enumerates allPlayers HC groups. Mission protection infers framework task state from several marker names, while combat waypoint override can retain only an index during active plans or infer permission from COMBAT/nearby known infantry. Same-index edits are not distinguished by this policy.",
      "disposition": "Keep CBE exact native route/task identity and specialist/Zeus boundaries; do not adopt index-only permission or the source framework marker list as general authority. Useful balance of combat initiative remains a gameplay comparison objective, not completed parity."
    },
    {
      "source": "scheduler/tick and selected processUnit1-110",
      "intent": "Bound per-frame actor work, cache registry snapshots, leave quiet followers native, prioritize immediate hazards and armour over long tactical actions.",
      "finding": "Tick3ms budget is tested before actor visits after pending-shot/contact/discovery/maintenance/telemetry work. First visit can execute even after preceding work consumes the budget. Full helper costs and scheduler startup/stop remain unread.",
      "disposition": "Do not claim a hard global source budget or import another scheduler. Compare quiet/focused activation and hazard priority with existing CBE actor/danger owner when the selected reaction descendants are reviewed."
    },
    {
      "source": "actions/recordGunfire/hearGunfire/observeGunfire",
      "intent": "Provide approximate acoustic contact areas without revealing a precise enemy object; reduce suppressed-primary shot radius.",
      "finding": "Per-shooter1s and per-group3s throttles; radius220m or65m for primary muzzle attachment,8-20m random contact error; no target object is sent. Spatial query and side filter do not prove acoustic propagation or sensed allegiance. Observer installs FiredMan once; handler removal/registration/locality callers not reviewed.",
      "disposition": "Retain approximate-area/age/throttle intent for comparison with CBE danger/contact evidence. Do not copy world shot-discovery/handler infrastructure or label these radii physically realistic. No sound handler installed by this review."
    },
    {
      "source": "registry/unregisterUnit",
      "intent": "Retire registry and dependent group plans when an actor leaves management.",
      "finding": "Cancellation occurs only for a living local actor, while several group release helpers run before that guard. Those helper bodies are not reviewed here.",
      "disposition": "Trace registry/event/locality and actual dependent release writers before implementing any integration; this body alone is not handover proof."
    }
  ],
